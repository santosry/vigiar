linters: linters_with_defaults(
    line_length_linter = line_length_linter(120L),
    object_name_linter = object_name_linter(
      styles = c("snake_case", "SNAKE_CASE", "dotted.case", "symbols"),
      regexes = "^validate\\.vigiar_tbl$"
    ),
    object_length_linter = object_length_linter(40L),
    T_and_F_symbol_linter = T_and_F_symbol_linter(),
    commented_code_linter = NULL,
    indentation_linter = indentation_linter(2L),
    semicolon_linter = NULL,
    # R CMD check already detects undefined globals/missing arguments using the
    # real package namespace. object_usage_linter works file-by-file and flags
    # internal cross-file helpers as undefined, producing broad false positives.
    object_usage_linter = NULL
  )
